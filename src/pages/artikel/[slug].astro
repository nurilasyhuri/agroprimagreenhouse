---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/common/Breadcrumb.astro';
import { getBreadcrumbSchema, getArticleSchema } from '../../utils/seo';
import { getCollection } from 'astro:content';
import { getArticleBySlug, getPublishedArticles } from '../../db/queries';
import { formatIndonesianDate } from '../../utils/date';
import { marked } from 'marked';

export const prerender = false;

// Edge CDN caching: 5 minutes max-age, 10 minutes stale-while-revalidate
Astro.response.headers.set(
  'Cache-Control',
  'public, s-maxage=300, stale-while-revalidate=600'
);

const { slug } = Astro.params;
if (!slug) {
  return Astro.redirect('/artikel/', 302);
}

// 1. Fetch from Neon Postgres
const dbArticle = await getArticleBySlug(slug);

let articleData: {
  slug: string;
  title: string;
  description: string;
  heroImage: string;
  author: string;
  category: string;
  tags: string[];
  publishDate: string;
  updatedDate?: string;
  body: string;
  htmlContent?: string;
} | null = null;

let ContentComponent: any = null;

if (dbArticle) {
  const parsedHtml = await marked.parse(dbArticle.content);
  articleData = {
    slug: dbArticle.slug,
    title: dbArticle.title,
    description: dbArticle.description,
    heroImage: dbArticle.heroImage,
    author: dbArticle.author,
    category: dbArticle.category,
    tags: Array.isArray(dbArticle.tags) ? dbArticle.tags : [],
    publishDate: formatIndonesianDate(dbArticle.publishedAt || dbArticle.scheduledAt || dbArticle.createdAt),
    updatedDate: dbArticle.updatedAt ? formatIndonesianDate(dbArticle.updatedAt) : undefined,
    body: dbArticle.content,
    htmlContent: parsedHtml,
  };
} else {
  // Fallback to static markdown content collection
  const allCollectionArticles = await getCollection('artikel');
  const collectionMatch = allCollectionArticles.find((a) => a.slug === slug);
  if (collectionMatch) {
    const rendered = await collectionMatch.render();
    ContentComponent = rendered.Content;
    articleData = {
      slug: collectionMatch.slug,
      title: collectionMatch.data.title,
      description: collectionMatch.data.description,
      heroImage: collectionMatch.data.heroImage,
      author: collectionMatch.data.author,
      category: collectionMatch.data.category,
      tags: collectionMatch.data.tags || [],
      publishDate: collectionMatch.data.publishDate,
      updatedDate: collectionMatch.data.updatedDate,
      body: collectionMatch.body || '',
    };
  }
}

if (!articleData) {
  return Astro.redirect('/404', 302);
}

// Fetch related articles
const allPublished = await getPublishedArticles({ limit: 6 });
let relatedArticles: Array<{
  slug: string;
  title: string;
  description: string;
  heroImage: string;
  category: string;
  body: string;
}> = [];

if (allPublished && allPublished.length > 0) {
  relatedArticles = allPublished
    .filter((a) => a.slug !== articleData?.slug)
    .slice(0, 2)
    .map((a) => ({
      slug: a.slug,
      title: a.title,
      description: a.description,
      heroImage: a.heroImage,
      category: a.category,
      body: a.content,
    }));
} else {
  const collectionFallback = await getCollection('artikel');
  relatedArticles = collectionFallback
    .filter((a) => a.slug !== articleData?.slug)
    .slice(0, 2)
    .map((a) => ({
      slug: a.slug,
      title: a.data.title,
      description: a.data.description,
      heroImage: a.data.heroImage,
      category: a.data.category,
      body: a.body || '',
    }));
}

function calculateReadingTime(text: string | undefined): string {
  if (!text) return '5 min read';
  const words = text.trim().split(/\s+/).length;
  const minutes = Math.max(2, Math.ceil(words / 180));
  return `${minutes} min read`;
}

const readingTime = calculateReadingTime(articleData.body);

const breadcrumbSchema = getBreadcrumbSchema([
  { name: 'Beranda', url: 'https://agroprimagreenhouse.com/' },
  { name: 'Artikel & Panduan', url: 'https://agroprimagreenhouse.com/artikel/' },
  { name: articleData.title, url: `https://agroprimagreenhouse.com/artikel/${articleData.slug}/` },
]);

const articleSchema = getArticleSchema({
  title: articleData.title,
  description: articleData.description,
  heroImage: articleData.heroImage,
  publishDate: articleData.publishDate,
  updatedDate: articleData.updatedDate,
  author: articleData.author,
  slug: articleData.slug,
});

const pageUrl = `https://agroprimagreenhouse.com/artikel/${articleData.slug}/`;
const waShareUrl = `https://api.whatsapp.com/send?text=${encodeURIComponent(articleData.title + ' - ' + pageUrl)}`;

const articleKeywords = [
  ...(articleData.tags || []),
  articleData.category,
  articleData.title,
  'panduan greenhouse',
  'agro prima greenhouse',
];
---

<BaseLayout
  title={`${articleData.title} - Panduan Agro Prima Greenhouse`}
  description={articleData.description}
  image={articleData.heroImage}
  type="article"
  keywords={articleKeywords}
  author={articleData.author}
  jsonLd={[articleSchema, breadcrumbSchema]}
>
  <div class="max-w-[740px] mx-auto px-4 sm:px-6 pt-6 pb-28">
    <Breadcrumb
      items={[
        { label: 'Artikel & Panduan', href: '/artikel/' },
        { label: articleData.title },
      ]}
    />

    <article class="mt-8">
      <!-- Article Header (Medium Style) -->
      <header class="space-y-4 mb-10">
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-sky-50 text-sky-800">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0284c7]"></span>
          {articleData.category}
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-zinc-900 tracking-tight leading-[1.18]">
          {articleData.title}
        </h1>

        <p class="text-lg sm:text-xl text-zinc-600 font-normal leading-relaxed">
          {articleData.description}
        </p>

        <!-- Medium Author Bar & Actions (No HR / Lines) -->
        <div class="flex items-center justify-between pt-4 pb-2">
          <div class="flex items-center gap-3.5">
            <div class="w-11 h-11 rounded-full bg-[#0284c7] text-white flex items-center justify-center font-bold text-sm shadow-sm shrink-0">
              AP
            </div>
            <div>
              <div class="flex items-center gap-2">
                <span class="font-semibold text-zinc-900 text-sm sm:text-base">{articleData.author}</span>
                <span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-semibold bg-sky-100 text-sky-800">
                  Praktisi
                </span>
              </div>
              <div class="flex items-center gap-2 text-xs text-zinc-500 mt-0.5">
                <span>{articleData.publishDate}</span>
                <span class="text-zinc-300">&bull;</span>
                <span>{readingTime}</span>
              </div>
            </div>
          </div>

          <!-- Share Actions -->
          <div class="flex items-center gap-1.5">
            <a
              href={waShareUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="p-2 rounded-full text-zinc-400 hover:text-[#25D366] hover:bg-zinc-100 transition-colors"
              title="Bagikan ke WhatsApp"
              aria-label="Bagikan ke WhatsApp"
            >
              <svg class="w-5 h-5 fill-current" viewBox="0 0 24 24">
                <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.711 2.598 2.664-.699c.971.53 1.77.814 2.796.814 3.18 0 5.767-2.587 5.768-5.766.001-3.182-2.585-5.769-5.768-5.769zm0-2.172c4.379 0 7.938 3.559 7.938 7.938 0 4.378-3.559 7.938-7.938 7.938-1.39 0-2.696-.36-3.832-.988l-4.2 1.1 1.12-4.088c-.68-1.182-1.026-2.53-1.026-3.962 0-4.379 3.559-7.938 7.938-7.938z"/>
              </svg>
            </a>
            <button
              type="button"
              id="copy-article-link-btn"
              class="p-2 rounded-full text-zinc-400 hover:text-zinc-700 hover:bg-zinc-100 transition-colors relative"
              title="Salin Tautan"
              aria-label="Salin Tautan"
            >
              <svg class="w-5 h-5 stroke-current fill-none" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
              </svg>
              <span id="copy-tooltip" class="absolute -bottom-8 left-1/2 -translate-x-1/2 bg-zinc-900 text-white text-[10px] py-0.5 px-2 rounded opacity-0 transition-opacity pointer-events-none whitespace-nowrap">
                Tersalin!
              </span>
            </button>
          </div>
        </div>
      </header>

      <!-- Hero Image -->
      <figure class="mb-12">
        <div class="rounded-2xl overflow-hidden bg-zinc-100 aspect-video shadow-sm">
          <img
            src={articleData.heroImage}
            alt={articleData.title}
            width="1200"
            height="675"
            class="w-full h-full object-cover"
            loading="eager"
            decoding="async"
          />
        </div>
        <figcaption class="text-center text-xs text-zinc-400 mt-3 font-normal">
          Dokumentasi teknis fasilitas &amp; instalasi standar Agro Prima Greenhouse
        </figcaption>
      </figure>

      <!-- Content (Medium Reading Typography - No HR / Lines) -->
      <div class="medium-article font-sans">
        {articleData.htmlContent ? (
          <div set:html={articleData.htmlContent} />
        ) : ContentComponent ? (
          <ContentComponent />
        ) : (
          <p>{articleData.body}</p>
        )}
      </div>

      <!-- Tags Section (Medium Topic Badges) -->
      {articleData.tags && articleData.tags.length > 0 && (
        <div class="mt-14 mb-10">
          <div class="flex flex-wrap gap-2">
            {articleData.tags.map((tag: string) => (
              <span class="px-3.5 py-1.5 rounded-full bg-zinc-100 hover:bg-zinc-200 text-zinc-700 text-xs font-medium transition-colors select-none">
                {tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Medium Author Bio Box -->
      <div class="mt-12 p-6 sm:p-8 rounded-2xl bg-zinc-50 space-y-4">
        <div class="flex items-center gap-4">
          <div class="w-14 h-14 rounded-full bg-[#0284c7] text-white flex items-center justify-center font-bold text-lg shadow-sm shrink-0">
            AP
          </div>
          <div>
            <span class="text-xs uppercase tracking-wider font-bold text-sky-600">Ditulis Oleh</span>
            <h3 class="text-base sm:text-lg font-bold text-zinc-900 mt-0.5">{articleData.author}</h3>
            <p class="text-xs text-zinc-500">Tim Ahli &amp; Aplikator Lapangan Agro Prima Greenhouse</p>
          </div>
        </div>
        <p class="text-xs sm:text-sm text-zinc-600 leading-relaxed">
          Berpengalaman dalam konstruksi greenhouse skala industri, fabrikasi rangka pipa galvanis hot-dip, instalasi atap plastik UV, kasa insect net, dan sistem fertigasi presisi di seluruh wilayah Indonesia.
        </p>
      </div>

      <!-- Related Articles ("More from Agro Prima") -->
      {relatedArticles.length > 0 && (
        <section class="mt-16 space-y-6">
          <div class="space-y-1">
            <span class="text-xs font-bold text-sky-600 uppercase tracking-wider">Rekomendasi Bacaan</span>
            <h2 class="text-2xl font-bold text-zinc-900 tracking-tight">Panduan Terkait Lainnya</h2>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            {relatedArticles.map((rel) => {
              const relReadTime = calculateReadingTime(rel.body);
              return (
                <a
                  href={`/artikel/${rel.slug}/`}
                  class="group block p-5 rounded-2xl bg-zinc-50/70 hover:bg-zinc-100/80 transition-all duration-200 space-y-3"
                >
                  <div class="aspect-[16/10] rounded-xl overflow-hidden bg-zinc-200">
                    <img
                      src={rel.heroImage}
                      alt={rel.title}
                      width="400"
                      height="250"
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
                      loading="lazy"
                      decoding="async"
                    />
                  </div>
                  <div class="space-y-1.5">
                    <div class="flex items-center gap-2 text-xs">
                      <span class="font-semibold text-sky-600">{rel.category}</span>
                      <span class="text-zinc-400">&bull;</span>
                      <span class="text-zinc-500">{relReadTime}</span>
                    </div>
                    <h3 class="font-bold text-zinc-900 text-base leading-snug group-hover:text-sky-600 transition-colors line-clamp-2">
                      {rel.title}
                    </h3>
                    <p class="text-xs text-zinc-500 line-clamp-2 leading-relaxed">
                      {rel.description}
                    </p>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}

      <!-- Bottom Consultation Box (Clean Editorial Tone) -->
      <div class="mt-16 p-8 sm:p-10 rounded-2xl bg-gradient-to-br from-[#0284c7] to-[#0369a1] text-white shadow-xl shadow-sky-900/10">
        <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
          <div class="space-y-2">
            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold bg-white/20 text-white border border-white/30">
              <span class="w-1.5 h-1.5 rounded-full bg-sky-200"></span>
              Konsultasi Praktisi Lapangan
            </span>
            <h3 class="text-xl sm:text-2xl font-extrabold text-white tracking-tight">Butuh Diskusi Teknis Lebih Lanjut?</h3>
            <p class="text-xs sm:text-sm text-sky-100 leading-relaxed max-w-xl">
              Tim spesialis Agro Prima Greenhouse siap membantu menjawab pertanyaan spesifik seputar pemilihan material atau pembangunan fasilitas greenhouse Anda.
            </p>
          </div>
          <a
            href="https://wa.me/6285183002070?text=Halo%20Agro%20Prima%20Greenhouse%2C%20saya%20membaca%20artikel%20dan%20ingin%20konsultasi%20lebih%20lanjut."
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-4 rounded-full bg-white hover:bg-sky-50 text-[#0284c7] font-bold text-xs transition-all shadow-lg shrink-0 select-none"
          >
            <span>Konsultasi via WA &rarr;</span>
          </a>
        </div>
      </div>
    </article>
  </div>
</BaseLayout>

<style is:global>
  /* Medium Article Typography Engine */
  .medium-article {
    color: #27272a;
    font-size: 19px;
    line-height: 1.82;
    letter-spacing: -0.011em;
  }

  /* Completely remove any hr or divider line */
  .medium-article hr {
    display: none !important;
  }

  .medium-article p {
    margin-bottom: 2rem;
    font-weight: 400;
    color: #27272a;
  }

  .medium-article h2 {
    font-size: 1.85rem;
    font-weight: 800;
    color: #18181b;
    margin-top: 3.5rem;
    margin-bottom: 1.25rem;
    letter-spacing: -0.025em;
    line-height: 1.25;
  }

  .medium-article h3 {
    font-size: 1.4rem;
    font-weight: 700;
    color: #18181b;
    margin-top: 2.5rem;
    margin-bottom: 0.85rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .medium-article strong {
    font-weight: 700;
    color: #09090b;
  }

  .medium-article em {
    font-style: italic;
  }

  .medium-article a {
    color: #0284c7;
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-color: #bae6fd;
    font-weight: 500;
    transition: all 0.2s ease;
  }

  .medium-article a:hover {
    color: #0369a1;
    text-decoration-color: #0284c7;
  }

  .medium-article ul {
    list-style-type: disc;
    margin: 1.5rem 0 2rem 1.5rem;
    padding-left: 0.5rem;
  }

  .medium-article ol {
    list-style-type: decimal;
    margin: 1.5rem 0 2rem 1.5rem;
    padding-left: 0.5rem;
  }

  .medium-article li {
    margin-bottom: 0.75rem;
    font-size: 18px;
    line-height: 1.75;
    color: #27272a;
  }

  .medium-article li::marker {
    color: #0284c7;
    font-weight: 600;
  }

  .medium-article blockquote {
    border-left: 3px solid #0284c7;
    padding: 0.5rem 0 0.5rem 1.5rem;
    margin: 2.5rem 0;
    font-style: italic;
    font-size: 1.25rem;
    line-height: 1.7;
    color: #3f3f46;
    background: transparent;
  }

  .medium-article blockquote p {
    margin-bottom: 0;
  }

  /* Responsive Medium-Styled Data Tables */
  .medium-article table {
    width: 100%;
    margin: 2.5rem 0;
    border-collapse: separate;
    border-spacing: 0;
    border-radius: 12px;
    overflow: hidden;
    background: #ffffff;
    border: 1px solid #e4e4e7;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .medium-article th {
    background-color: #f8fafc;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: #475569;
    padding: 12px 16px;
    border-bottom: 1px solid #e2e8f0;
    text-align: left;
  }

  .medium-article td {
    padding: 14px 16px;
    color: #334155;
    border-bottom: 1px solid #f1f5f9;
  }

  .medium-article tr:last-child td {
    border-bottom: none;
  }

  .medium-article tr:nth-child(even) {
    background-color: #fafaf9;
  }

  @media (max-width: 640px) {
    .medium-article {
      font-size: 17px;
      line-height: 1.75;
    }

    .medium-article h2 {
      font-size: 1.5rem;
      margin-top: 2.5rem;
    }

    .medium-article h3 {
      font-size: 1.25rem;
      margin-top: 2rem;
    }

    .medium-article table {
      display: block;
      overflow-x: auto;
      white-space: nowrap;
    }
  }
</style>

<script>
  function setupCopyLink() {
    const copyBtn = document.getElementById('copy-article-link-btn');
    const tooltip = document.getElementById('copy-tooltip');

    if (!copyBtn || !tooltip) return;

    copyBtn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(window.location.href);
        tooltip.classList.remove('opacity-0');
        tooltip.classList.add('opacity-100');

        setTimeout(() => {
          tooltip.classList.remove('opacity-100');
          tooltip.classList.add('opacity-0');
        }, 2000);
      } catch (err) {
        console.error('Failed to copy: ', err);
      }
    });
  }

  setupCopyLink();
  document.addEventListener('astro:page-load', setupCopyLink);
</script>
